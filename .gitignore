# Office 临时锁文件（Word/Excel 打开文档时自动生成，无内容价值）
~$*

# 系统垃圾文件
Thumbs.db
desktop.ini
.DS_Store

# Python 缓存
__pycache__/
*.pyc

# Python 虚拟环境（各人本机自己建，不进仓库）
.venv/
venv/

# SQLite 运行时数据（backend/data.db 删掉即清空历史）
# -wal / -shm 是 WAL 模式产生的同生文件，同样是运行时数据，别提交
*.db
*.db-wal
*.db-shm

# 打包分发的压缩包（可随时重新生成）
_send/

# 三维模型的原始导出备份（本地保险，用 fixGlbNodeNames.mjs 可随时重新对齐）
# 仓库里存的是对齐后的 泵房.glb，这份备份不进库
_工具/*.glb
